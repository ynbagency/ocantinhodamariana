APP_NAME="O Cantinho da Mariana"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_PT
APP_FALLBACK_LOCALE=pt_PT
APP_TIMEZONE=Europe/Lisbon

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cantinho_mariana
DB_USERNAME=cantinho
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

FILESYSTEM_DISK=local

SIGNAGE_MANIFEST_TTL=300
SIGNAGE_HEARTBEAT_INTERVAL=60
SIGNAGE_STALE_AFTER=300

SOCIAL_AUTOPUBLISH=false

META_ENABLED=false
META_GRAPH_VERSION=
META_PAGE_ID=
META_INSTAGRAM_BUSINESS_ID=
META_ACCESS_TOKEN=
BACKUP_DISK=local
BACKUP_RETENTION_DAYS=14

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
