{
  "name": "yournewbrand/cantinho-mariana",
  "type": "project",
  "description": "O Cantinho da Mariana",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "filament/filament": "^5.0",
    "laravel/tinker": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "laravel/pint": "^1.0",
    "mockery/mockery": "~1.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": { "Tests\\": "tests/" }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan package:discover --ansi"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
